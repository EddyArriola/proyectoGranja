generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Cliente {
  ClienteID    Int            @id(map: "PK__Cliente__71ABD0A737256C23") @default(autoincrement())
  Nombre       String?        @db.VarChar(50)
  Direccion    String?        @db.VarChar(100)
  Apellidos    String?        @db.VarChar(50)
  Email        String?        @db.VarChar(100)
  Telefono     Int?
  VentasHuevos VentasHuevos[]
}

model DetalleVenta {
  DetalleID    Int            @id(map: "PK__DetalleV__6E19D6FAB041C259") @default(autoincrement())
  HuevoID      Int?
  cantidad     Int?
  TipoHuevo    TipoHuevo?     @relation(fields: [HuevoID], references: [HuevoID], onDelete: NoAction, onUpdate: NoAction, map: "fk_detalle")
  VentasHuevos VentasHuevos[]
}

model Galeras {
  GaleraID         Int                @id(map: "PK__Galeras__3CECAE2B272AAF87") @default(autoincrement())
  Nombre           String?            @db.VarChar(50)
  Capacidad        Int?
  Cantidad         Int?
  Gallinas         Gallinas[]
  HuevosProduccion HuevosProduccion[]
}

model Gallinas {
  GallinaID       Int       @id(map: "PK__Gallinas__138FD721CF57970E") @default(autoincrement())
  Nombre          String?   @db.VarChar(50)
  GaleraID        Int?
  FechaNacimiento DateTime? @db.Date
  FechaLlegada    DateTime? @db.Date
  Galeras         Galeras?  @relation(fields: [GaleraID], references: [GaleraID], onDelete: NoAction, onUpdate: NoAction, map: "FK__Gallinas__Galera__68487DD7")
}

model HuevosProduccion {
  ProduccionID    Int         @id(map: "PK__HuevosPr__6632E91D34E852BE") @default(autoincrement())
  GaleraID        Int?
  InventarioID    Int?
  FechaProduccion DateTime?   @db.Date
  Cantidad        Int?
  Galeras         Galeras?    @relation(fields: [GaleraID], references: [GaleraID], onDelete: NoAction, onUpdate: NoAction, map: "FK_ProduccionGalera")
  Inventario      Inventario? @relation(fields: [InventarioID], references: [InventarioID], onDelete: NoAction, onUpdate: NoAction, map: "FK_ProduccionInventario")
}

model TipoHuevo {
  HuevoID      Int            @id(map: "PK__TipoHuev__8FBC56517A374326") @default(autoincrement())
  Nombre       String?        @db.VarChar(10)
  Precio       Decimal?       @db.Decimal(10, 2)
  Descripcion  String?        @db.VarChar(50)
  DetalleVenta DetalleVenta[]
  Inventario   Inventario[]
}

model VentasHuevos {
  VentaID      Int           @id(map: "PK__VentasHu__5B41514C2962FB08") @default(autoincrement())
  FechaVenta   DateTime?     @db.Date
  TotalVenta   Float?
  ClienteID    Int?
  DetalleID    Int?
  Cliente      Cliente?      @relation(fields: [ClienteID], references: [ClienteID], onDelete: NoAction, onUpdate: NoAction, map: "FK__VentasHue__Clien__7A672E12")
  DetalleVenta DetalleVenta? @relation(fields: [DetalleID], references: [DetalleID], onDelete: NoAction, onUpdate: NoAction, map: "FK_DETALLE_VENTA")
}

model Inventario {
  InventarioID     Int                @id(map: "PK__Inventar__FB8A24B7349993C8") @default(autoincrement())
  Nombre           String?            @db.VarChar(50)
  HuevoID          Int?
  Existencias      Int?
  HuevosProduccion HuevosProduccion[]
  TipoHuevo        TipoHuevo?         @relation(fields: [HuevoID], references: [HuevoID], onDelete: NoAction, onUpdate: NoAction, map: "FK_InventarioTipo")
}
